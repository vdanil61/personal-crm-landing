---
const benefits = [
  {
    title: "Не теряете людей.",
    text: "Каждый новый знакомый попадает в список, а не теряется в телефоне.",
  },
  {
    title: "Приходите на встречу подготовленным.",
    text: "Открыли карточку и вспомнили, о чём говорили в прошлый раз.",
  },
  {
    title: "Держите слово.",
    text: "Договорённости записаны, а не держатся в голове.",
  },
  {
    title: "Быстро находите нужного человека.",
    text: "Вводите часть имени, и он уже перед вами.",
  },
];
---

<section
  aria-labelledby="benefits-title"
  class="flex flex-col gap-20 px-gutter pb-section lg:gap-40 lg:px-gutter-lg lg:pb-section-lg"
>
  <h2 id="benefits-title" class="text-heading lg:text-heading-lg">Что изменится</h2>
  <ul class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12 xl:grid-cols-4">
    {
      benefits.map((benefit) => (
        <li class="flex flex-col gap-8 bg-white px-16 py-20 lg:gap-14 lg:px-28 lg:py-32">
          <h3 class="text-title lg:text-title-lg lg:text-balance">{benefit.title}</h3>
          <p class="text-benefit text-muted lg:text-benefit-lg">{benefit.text}</p>
        </li>
      ))
    }
  </ul>
</section>
