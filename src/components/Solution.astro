---
// Lucide icons (MIT): arrow-down-a-z, contact, notebook-pen, search
const features = [
  {
    text: "Список всех контактов по алфавиту",
    icon: '<path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="M20 8h-5"/><path d="M15 10V6.5a2.5 2.5 0 0 1 5 0V10"/><path d="M15 14h5l-5 6h5"/>',
  },
  {
    text: "Карточка человека: имя, кто это, откуда знакомы, телефон, почта",
    icon: '<path d="M16 2v2"/><path d="M7 22v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/><path d="M8 2v2"/><circle cx="12" cy="11" r="3"/><rect x="3" y="4" width="18" height="18" rx="2"/>',
  },
  {
    text: "Заметки после разговора с датой, новые сверху",
    icon: '<path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/>',
  },
  {
    text: "Поиск по имени, который не путается в «е» и «ё»",
    icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  },
];
---

<section
  aria-labelledby="solution-title"
  class="flex flex-col gap-20 px-gutter pb-section lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-80 lg:px-gutter-lg lg:pb-section-lg"
>
  <h2 id="solution-title" class="text-heading lg:text-heading-lg">Все ваши люди в одном месте</h2>
  <ul class="flex flex-col bg-white lg:grid lg:grid-cols-2">
    {
      features.map((feature, index) => (
        <li
          class:list={[
            "flex items-center gap-12 border-line p-16 lg:flex-col lg:items-stretch lg:gap-24 lg:px-28 lg:py-32",
            index < 3 && "border-b",
            index >= 2 && "lg:border-b-0",
            index % 2 === 0 && "lg:border-r",
          ]}
        >
          <div class="grid size-40 flex-none place-items-center bg-accent-soft text-accent-hover lg:size-48">
            <svg
              aria-hidden="true"
              class="size-22 lg:size-24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={feature.icon}
            />
          </div>
          <p class="text-feature lg:text-feature-lg">{feature.text}</p>
        </li>
      ))
    }
  </ul>
</section>
