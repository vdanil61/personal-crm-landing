---
// Product illustration with made-up data, not interactive
const notes = [
  { date: "14 окт", text: "Созвониться после релиза", active: true },
  { date: "22 мая", text: "Ищет подрядчика на брендинг", active: false },
];
---

<div aria-hidden="true" class="flex flex-col bg-white pb-16 lg:pb-28 lg:shadow-card">
  <div class="flex items-start justify-between gap-12 p-16 lg:gap-16 lg:p-28">
    <div class="flex flex-col gap-4 lg:gap-6">
      <div class="text-card-name lg:text-card-name-lg">Саша Ковалёв</div>
      <div class="text-card-meta text-subtle lg:text-card-meta-lg">Дизайнер · конференция, май 2026</div>
      <div class="mt-4 flex flex-wrap gap-x-12 gap-y-4 text-card-contacts lg:mt-6 lg:gap-x-16 lg:text-card-contacts-lg">
        <span>+7 900 123-45-67</span><span>sasha@kovalev.ru</span>
      </div>
    </div>
    <div
      class="grid size-40 flex-none place-items-center bg-accent text-card-avatar text-white lg:size-56 lg:text-card-avatar-lg"
    >
      СК
    </div>
  </div>
  <div class="px-16 pb-8 text-card-label text-accent-hover uppercase lg:px-28 lg:pb-12 lg:text-card-label-lg">
    Заметки
  </div>
  {
    notes.map((note) => (
      <div
        class:list={[
          "mx-16 flex flex-col gap-2 border-l-2 py-10 pl-14 lg:mx-28 lg:gap-4 lg:py-14 lg:pl-18",
          note.active ? "border-accent" : "border-line-soft text-muted",
        ]}
      >
        <div class="text-note-date text-subtle lg:text-note-date-lg">{note.date}</div>
        <div class="text-note lg:text-note-lg">{note.text}</div>
      </div>
    ))
  }
</div>
