---
import { APP_URL } from "../config";

interface Props {
  variant?: "light" | "dark";
  class?: string;
}

const { variant = "light", class: className } = Astro.props;
const isDark = variant === "dark";
const corners = ["-top-9 -left-5", "-top-9 -right-5", "-bottom-9 -left-5", "-bottom-9 -right-5"];
---

<a
  href={APP_URL}
  class:list={[
    "relative flex h-56 items-center justify-between bg-accent px-20 text-cta text-white transition-colors",
    "lg:h-64 lg:px-28 lg:text-cta-lg",
    isDark ? "hover:bg-accent-hover-dark" : "hover:bg-accent-hover",
    className,
  ]}
>
  Открыть CRM<span aria-hidden="true" class="font-arrow">→</span>
  {
    corners.map((position) => (
      <span
        aria-hidden="true"
        class:list={["absolute font-corner text-corner", position, isDark ? "text-mark-dark" : "text-accent"]}
      >
        +
      </span>
    ))
  }
</a>
